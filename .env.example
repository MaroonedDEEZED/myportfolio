PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/marouane-portfolio

# Contact form delivery.
# MAIL_PASSWORD is a Google App Password (16 characters, no spaces) — NOT your
# normal Gmail password. Create one at https://myaccount.google.com/apppasswords
# after turning on 2-Step Verification.
MAIL_USER=bouakbamarouane@gmail.com
MAIL_PASSWORD=
# Where enquiries are delivered. Defaults to MAIL_USER when left empty.
MAIL_TO=bouakbamarouane@gmail.com

# Optional: send through a non-Gmail SMTP relay instead.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
