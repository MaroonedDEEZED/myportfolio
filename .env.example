PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/marouane-portfolio

# Contact form delivery via EmailJS (https://dashboard.emailjs.com).
# Service ID from Email Services, Template ID from Email Templates, Public key
# from Account > API Keys, Private key is shown once when generated (Account >
# API Keys > "Add private key" / regenerate).
EMAILJS_SERVICE_ID=service_xxxxxxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
